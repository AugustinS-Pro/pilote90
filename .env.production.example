# Variables d'environnement de production — a copier en .env.production
# sur le serveur, et a NE JAMAIS versionner.

# Base PostgreSQL Supabase. DATABASE_URL passe par le pooler,
# DIRECT_URL par la connexion directe (migrations et sauvegardes).
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Secret de signature des jetons de session.
# A generer : openssl rand -base64 32
NEXTAUTH_SECRET=""

# URL publique de l'application, avec le protocole.
NEXTAUTH_URL="https://pilote90.exemple.fr"

# Supervision (facultatif)
PILOTE90_URL="https://pilote90.exemple.fr/login"
PILOTE90_ALERTE_MAIL=""
